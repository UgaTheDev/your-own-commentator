{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clips.schema.json",
  "title": "Games index",
  "type": "object",
  "required": [
    "clips"
  ],
  "properties": {
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "clipId",
          "title",
          "manifestUrl"
        ],
        "properties": {
          "clipId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "manifestUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "attribution": {
            "type": "string"
          }
        }
      }
    }
  }
}