{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "C3 Manifest v2",
  "type": "object",
  "required": [
    "clipId",
    "videoUrl",
    "tracks",
    "events",
    "cues",
    "ruleCards",
    "state"
  ],
  "$defs": {
    "https": {
      "type": "string",
      "pattern": "^https://"
    },
    "sortedT": {
      "type": "object",
      "required": [
        "t"
      ],
      "properties": {
        "t": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  },
  "properties": {
    "clipId": {
      "type": "string"
    },
    "videoUrl": {
      "$ref": "#/$defs/https"
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "persona",
          "lang",
          "label",
          "src"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "persona": {
            "type": "string"
          },
          "lang": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "src": {
            "$ref": "#/$defs/https"
          },
          "kind": {
            "enum": [
              "single",
              "booth"
            ]
          },
          "voices": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "role",
                "voice"
              ],
              "properties": {
                "role": {
                  "enum": [
                    "pbp",
                    "analyst"
                  ]
                },
                "voice": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "t",
          "type",
          "team",
          "jersey",
          "ruleCardId"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "t": {
            "type": "number"
          },
          "type": {
            "type": "string"
          },
          "team": {
            "type": [
              "string",
              "null"
            ]
          },
          "jersey": {
            "type": [
              "integer",
              "null"
            ]
          },
          "ruleCardId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "cues": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "t",
            "eventId",
            "text"
          ],
          "properties": {
            "t": {
              "type": "number"
            },
            "eventId": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "role": {
              "enum": [
                "pbp",
                "analyst"
              ]
            }
          }
        }
      }
    },
    "ruleCards": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "title",
          "body"
        ]
      }
    },
    "state": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "eventId",
          "t",
          "score"
        ],
        "properties": {
          "score": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          }
        }
      }
    },
    "questions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "q",
            "answers"
          ],
          "properties": {
            "q": {
              "type": "string"
            },
            "answers": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "text",
                  "audioUrl"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "audioUrl": {
                    "$ref": "#/$defs/https"
                  }
                }
              }
            }
          }
        }
      }
    },
    "roster": {
      "type": "array"
    },
    "replays": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "eventId",
          "src",
          "duration"
        ],
        "properties": {
          "eventId": {
            "type": "string"
          },
          "src": {
            "$ref": "#/$defs/https"
          },
          "duration": {
            "type": "number"
          }
        }
      }
    },
    "minimap": {
      "type": "object",
      "required": [
        "hz",
        "frames"
      ],
      "properties": {
        "hz": {
          "type": "number"
        },
        "frames": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "t",
              "players",
              "ball"
            ],
            "properties": {
              "t": {
                "type": "number"
              },
              "players": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "team",
                    "x",
                    "y"
                  ]
                }
              },
              "ball": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "recaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "t",
          "src",
          "text"
        ],
        "properties": {
          "t": {
            "type": "number"
          },
          "src": {
            "$ref": "#/$defs/https"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "talk": {
      "type": "object",
      "required": [
        "wsUrl"
      ],
      "properties": {
        "wsUrl": {
          "type": "string",
          "pattern": "^wss://"
        }
      }
    },
    "party": {
      "type": "object",
      "required": [
        "wsUrl"
      ],
      "properties": {
        "wsUrl": {
          "type": "string",
          "pattern": "^wss://"
        }
      }
    },
    "highlights": {
      "type": "object",
      "required": [
        "src",
        "duration"
      ],
      "properties": {
        "src": {
          "type": "string",
          "pattern": "^https://"
        },
        "duration": {
          "type": "number"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
